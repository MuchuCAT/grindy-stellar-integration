{
  "name": "grindy-stellar-integration",
  "version": "0.1.0",
  "private": true,
  "description": "Open-source attribution and settlement rails for measurable Stellar DeFi campaigns.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.8.1",
  "scripts": {
    "build": "pnpm -r build",
    "check-types": "pnpm --filter '@grindy/*' build && pnpm -r check-types",
    "test": "pnpm -r test",
    "demo": "pnpm --filter grindy-stellar-wallet-demo dev",
    "vault:ui": "pnpm --filter grindy-reward-vault-next dev",
    "contract:build": "pnpm contract:build:all",
    "contract:build:all": "pnpm contract:build:vault && pnpm contract:build:escrow && pnpm contract:build:distributor",
    "contract:build:vault": "stellar contract build --manifest-path contracts/campaign-reward-vault/Cargo.toml",
    "contract:build:escrow": "stellar contract build --manifest-path contracts/campaign-escrow/Cargo.toml",
    "contract:build:distributor": "stellar contract build --manifest-path contracts/reward-distributor/Cargo.toml",
    "contract:test": "pnpm contract:test:all",
    "contract:test:all": "pnpm contract:test:vault && pnpm contract:test:escrow && pnpm contract:test:distributor",
    "contract:test:vault": "cargo test --manifest-path contracts/campaign-reward-vault/Cargo.toml",
    "contract:test:escrow": "cargo test --manifest-path contracts/campaign-escrow/Cargo.toml",
    "contract:test:distributor": "cargo test --manifest-path contracts/reward-distributor/Cargo.toml"
  },
  "workspaces": [
    "packages/*",
    "adapters/*",
    "examples/*"
  ],
  "devDependencies": {
    "@types/node": "^22.13.13",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
