{
  "name": "grindy-stellar-integration",
  "version": "0.1.0",
  "private": true,
  "description": "Open-source Stellar wallet connection and wallet-to-profile linking modules for Grindy's SCF Integration Track work.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.8.1",
	"scripts": {
		"build": "pnpm -r build",
		"check-types": "pnpm --filter '@grindy/*' build && pnpm -r check-types",
		"test": "pnpm -r test",
		"demo": "pnpm --filter grindy-stellar-wallet-demo dev"
	},
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "devDependencies": {
    "@types/node": "^22.13.13",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
