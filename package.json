{
  "name": "grindy-stellar-integration",
  "version": "0.1.0",
  "private": true,
  "description": "Open-source Stellar wallet, Soroban, and testnet integration modules for Grindy.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.8.1",
  "scripts": {
    "build": "pnpm -r build",
    "check-types": "pnpm --filter '@grindy/*' build && pnpm -r check-types",
    "test": "pnpm -r test",
    "demo": "pnpm --filter grindy-stellar-wallet-demo dev",
    "vault:ui": "pnpm --filter grindy-reward-vault-next dev",
    "contract:build": "stellar contract build --manifest-path contracts/campaign-reward-vault/Cargo.toml",
    "contract:test": "cargo test --manifest-path contracts/campaign-reward-vault/Cargo.toml"
  },
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "devDependencies": {
    "@types/node": "^22.13.13",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
